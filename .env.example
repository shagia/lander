# Copy to `.env` for local development overrides.
#
# Local mode (default): leave PUBLIC_KEYSTATIC_GITHUB_REPO empty.
#   → npm run dev → edit at /keystatic → commit when ready.
#
# Hosted CMS on Vercel: see docs/deploy-vercel.md
#   1. Deploy button creates your repo + Vercel project
#   2. Set PUBLIC_KEYSTATIC_GITHUB_REPO=you/your-clone below
#   3. npm run dev → Create GitHub App (use your Vercel URL in the wizard)
#   4. Copy the filled values to the Vercel project env vars and redeploy
#
# GitHub App docs: https://keystatic.com/docs/github-mode

# --- Local mode (default) ---
# Leave PUBLIC_KEYSTATIC_GITHUB_REPO empty → storage.kind = "local"

# --- GitHub mode ---
# Set the repo to enable GitHub mode and the first-run "Create GitHub App" wizard.
# Use the PUBLIC_ name so the Keystatic Admin UI (browser) can read it.
PUBLIC_KEYSTATIC_GITHUB_REPO=
# Optional duplicate for server-only tooling (same value as PUBLIC_…):
# KEYSTATIC_GITHUB_REPO=owner/name

# Filled automatically after the Keystatic GitHub App wizard, or paste manually:
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Two-repo content pull (optional / advanced) ---
# Only needed when PUBLIC_KEYSTATIC_GITHUB_REPO is a *different* repo than the
# site repo Vercel builds. Fine-grained PAT with Contents: Read on the content repo.
# CONTENT_GITHUB_TOKEN=
# Force a pull locally (outside Vercel): CONTENT_PULL=1
# CONTENT_PULL=
