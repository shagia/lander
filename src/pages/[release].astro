---
import LandingPage from "../components/LandingPage.astro";
import Layout from "../layouts/Layout.astro";
import {
	coverSrc,
	getReleaseById,
	releasePageBackgroundSrc,
} from "../lib/landing";

const releaseId = Astro.params.release;
if (!releaseId) {
	return Astro.redirect("/");
}

const selectedRelease = await getReleaseById(releaseId);
if (!selectedRelease) {
	return Astro.redirect("/");
}
---

<Layout
	cover={releasePageBackgroundSrc(selectedRelease.data)}
	theme={selectedRelease.data.theme}
	title={selectedRelease.data.title}
	description={selectedRelease.data.description}
	image={
		selectedRelease.data.cover != null
			? coverSrc(selectedRelease.data.cover)
			: undefined
	}
>
	<LandingPage selectedRelease={selectedRelease} />
</Layout>
