---
import logo from "../assets/ui/logo.svg";
import logoWhite from "../assets/ui/logo-white.svg";
import "../styles/global/header.scss";
---

<header class="site-header" transition:persist="site-header">
	<a href="/" class="site-logo-link" aria-label="Home">
		<img
			src={logo.src}
			width="361"
			height="264"
			alt="Logo"
			class="site-logo site-logo-light"
		/>
		<img
			src={logoWhite.src}
			width="361"
			height="264"
			alt=""
			class="site-logo site-logo-dark"
		/>
	</a>
</header>
