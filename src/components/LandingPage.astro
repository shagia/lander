---
import type { SlugEntry } from "../lib/landing";
import {
	siSoundcloud,
	siApplemusic,
	siSpotify,
	siBandcamp,
	siTidal,
} from "simple-icons";
import "../styles/components/landing-page.scss";
import DefaultLinksContent from "./DefaultLinksContent.astro";
import Releases from "./Releases.astro";

const slugLinkSvgById: Record<string, string> = {
	soundcloud: siSoundcloud.svg,
	"apple-music": siApplemusic.svg,
	spotify: siSpotify.svg,
	bandcamp: siBandcamp.svg,
	tidal: siTidal.svg,
};
const slugLinkSvgFallback = siBandcamp.svg;

function slugLinkSvgMarkup(id: string) {
	const svg = slugLinkSvgById[id] ?? slugLinkSvgFallback;
	// Simple Icons fill the 24×24 canvas (some paths even spill past it).
	// Expand the viewBox so SVG overflow:hidden does not clip the marks.
	return svg.replace('viewBox="0 0 24 24"', 'viewBox="-2 -2 28 28"');
}

/** Appends host in parentheses for screen readers (e.g. ` (example.com)`). */
function linkDestinationHint(href: string) {
	try {
		const host = new URL(href).host;
		return host ? ` (${host})` : "";
	} catch {
		return "";
	}
}

interface Props {
	selectedSlug?: SlugEntry;
}

const { selectedSlug } = Astro.props;

const aboutName =
	selectedSlug?.data.music?.artist ?? selectedSlug?.data.title ?? "";

const slugSmallLinks = selectedSlug?.data.links?.small ?? [];
const slugLargeLinks = selectedSlug?.data.links?.large ?? [];
---

<div class="landing-shell">
	<main class="main-container">
		<div class="main-container-fades" aria-hidden="true"></div>
		<div class="main-container-scroll">
			{
				selectedSlug && (
					<section>
						<div class="media-container-wrapper">
							{selectedSlug.data.cover && (
								<div class="cover-container">
									{/* I have zero issues with assuming that a string, no matter what, is being passed to the cover key - there's a smarter way for this but oh well */}
									<img
										src={
											selectedSlug.data
												.cover as unknown as string
										}
										alt={selectedSlug.data.title}
										class="cover-image"
									/>
								</div>
							)}
							{selectedSlug.data.music && (
								<div class="media-container">
									<audio
										controls
										src={
											selectedSlug.data.music.audioUrl
										}
									/>
								</div>
							)}
							{(slugSmallLinks.length > 0 ||
								slugLargeLinks.length > 0) && (
								<>
									{slugLargeLinks.length > 0 && (
										<ul class="links-large-list">
											{slugLargeLinks.map((link) => (
												<li>
													<a
														href={link.href}
														class="link-large"
													>
														<span
															class="link-large-icon"
															aria-hidden="true"
															set:html={slugLinkSvgMarkup(
																link.id,
															)}
														/>
														<span class="link-large-label">
															{link.label}
														</span>
														<span class="visually-hidden">
															{linkDestinationHint(
																link.href,
															)}
														</span>
													</a>
												</li>
											))}
										</ul>
									)}
									{slugSmallLinks.length > 0 && (
										<ul class="links-small-list">
											{slugSmallLinks.map((link) => (
												<li>
													<a
														href={link.href}
														class="link-small"
													>
														<span class="visually-hidden">
															{link.label}
															{linkDestinationHint(
																link.href,
															)}
														</span>
														<span
															class="link-small-icon"
															aria-hidden="true"
															set:html={slugLinkSvgMarkup(
																link.id,
															)}
														/>
													</a>
												</li>
											))}
										</ul>
									)}
								</>
							)}
						</div>

						<br />

						{selectedSlug.data.featured && (
							<>
								<h2>{selectedSlug.data.title}</h2>
								<section class="default-links-section">
									<h3>
										{selectedSlug.data.featured.headline}
									</h3>
									{selectedSlug.data.featured.summary.map(
										(paragraph) => (
											<p>{paragraph}</p>
										),
									)}
								</section>
							</>
						)}
					</section>
				)
			}

			{
				selectedSlug ? (
					<details class="default-links-disclosure">
						<summary class="default-links-summary">
							<span class="default-links-summary-label">
								About {aboutName}
							</span>
						</summary>
						<div class="default-links-disclosure-panel">
							<DefaultLinksContent
								linkDestinationHint={linkDestinationHint}
							/>
						</div>
					</details>
				) : (
					<DefaultLinksContent
						linkDestinationHint={linkDestinationHint}
					/>
				)
			}

			<Releases onSlugPage={Boolean(selectedSlug)} />
		</div>
	</main>
</div>

<script>
	const firefoxNeedsBgScrollPolyfill = CSS.supports("-moz-appearance: none");
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const scroller = document.querySelector(".landing-shell");

	if (
		firefoxNeedsBgScrollPolyfill &&
		!prefersReducedMotion &&
		scroller instanceof HTMLElement
	) {
		document.body.classList.add("bg-scroll-js");

		const bgImage = new Image();
		let ticking = false;
		let maxTravel = 0;

		const backgroundUrl = () => {
			const value = getComputedStyle(document.body)
				.getPropertyValue("--page-bg")
				.trim();
			return value.match(/url\((['"]?)(.*?)\1\)/)?.[2] ?? "";
		};

		const coverOverflowY = () => {
			const { naturalWidth, naturalHeight } = bgImage;
			if (!naturalWidth || !naturalHeight) return 0;

			const scale = Math.max(
				window.innerWidth / naturalWidth,
				window.innerHeight / naturalHeight,
			);
			return Math.max(0, naturalHeight * scale - window.innerHeight);
		};

		const syncBackground = () => {
			const maxScroll = scroller.scrollHeight - scroller.clientHeight;
			const progress = maxScroll > 0 ? scroller.scrollTop / maxScroll : 0;
			document.body.style.setProperty(
				"--bg-scroll",
				`${progress * maxTravel}px`,
			);
			ticking = false;
		};

		const requestSync = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(syncBackground);
		};

		const recalc = () => {
			maxTravel = coverOverflowY() / 2;
			syncBackground();
		};

		const url = backgroundUrl();
		if (url) {
			bgImage.addEventListener("load", recalc);
			bgImage.src = url;
			if (bgImage.complete) recalc();
		}

		scroller.addEventListener("scroll", requestSync, { passive: true });
		window.addEventListener("resize", recalc);

		const resizeObserver = new ResizeObserver(recalc);
		resizeObserver.observe(scroller);
		for (const child of scroller.children) {
			resizeObserver.observe(child);
		}
	}
</script>
