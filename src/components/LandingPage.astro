---
import type { SlugEntry } from "../lib/landing";
import { defaultLinks } from "../lib/landing";

interface Props {
	selectedSlug?: SlugEntry;
}

const { selectedSlug } = Astro.props;
---

<main>

	{
		selectedSlug && (
			<section>
				{selectedSlug.data.music && (
					<article>
						<audio controls src={selectedSlug.data.music.audioUrl}></audio>
					</article>
				)}

				<h2>{selectedSlug.data.title}</h2>
				<p>{selectedSlug.data.description}</p>

				{selectedSlug.data.links.length > 0 && (
					<>
						<h3>Slug-Specific Links</h3>
						<ul>
							{selectedSlug.data.links.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</>
				)}
				<br />

				{selectedSlug.data.featured && (
					<article>
						<h3>{selectedSlug.data.featured.headline}</h3>
						<p>{selectedSlug.data.featured.summary}</p>
					</article>
				)}
			</section>
		)
	}
	
	<section>
		<h1>Link Lander</h1>
		<p>Default links are always visible. Slug-specific links and featured content append below.</p>
	</section>

	<section>
		<h2>Default Links</h2>
		<ul>
			{
				defaultLinks.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))
			}
		</ul>
	</section>

	
</main>

<style>
	main {
		max-width: 50rem;
		margin: 2rem;
		padding: 2rem 1rem 4rem;
		font-family: Inter, system-ui, sans-serif;
		line-height: 1.5;
		background-color: #fff;
		border-radius: 1rem;
	}

	section {
		margin-bottom: 2rem;
	}

	h1,
	h2,
	h3 {
		margin: 0 0 0.5rem;
	}

	ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	audio {
		width: 100%;
		max-width: 26rem;
	}
</style>
