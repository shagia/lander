---
import type { SlugEntry } from "../lib/landing";
import { defaultLinks } from "../lib/landing";

interface Props {
	selectedSlug?: SlugEntry;
}

const { selectedSlug } = Astro.props;

const aboutName =
	selectedSlug?.data.music?.artist ?? selectedSlug?.data.title ?? "";
---

<main>
	{
		selectedSlug && (
			<section>
				<div class="media-container-wrapper">
					{selectedSlug.data.cover && (
						<div class="cover-container">
							<article>
								{/* I have zero issues with assuming that a string, no matter what, is being passed to the cover key - there's a smarter way for this but oh well */}
								<img
									src={
										selectedSlug.data
											.cover as unknown as string
									}
									alt={selectedSlug.data.title}
									class="cover-image"
								/>
							</article>
						</div>
					)}
					{selectedSlug.data.music && (
						<div class="media-container">
							<article>
								<audio
									controls
									src={selectedSlug.data.music.audioUrl}
								/>
							</article>
						</div>
					)}
				</div>

				{(selectedSlug.data.links.paid.length > 0 ||
					selectedSlug.data.links.free.length > 0) && (
					<>
						{selectedSlug.data.links.paid.length > 0 && (
							<>
								<ul class="paid-links-list">
									{selectedSlug.data.links.paid.map(
										(link) => (
											<li>
												<a href={link.href}>
													{link.label}
												</a>
											</li>
										),
									)}
								</ul>
							</>
						)}
						{selectedSlug.data.links.free.length > 0 && (
							<>
								<ul class="free-links-list">
									{selectedSlug.data.links.free.map(
										(link) => (
											<li>
												<a href={link.href}>
													{link.label}
												</a>
											</li>
										),
									)}
								</ul>
							</>
						)}
					</>
				)}
				<br />

				{selectedSlug.data.featured && (
					<article>
						<h2>{selectedSlug.data.title}</h2>
						<h3>{selectedSlug.data.featured.headline}</h3>
						{selectedSlug.data.featured.summary.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</article>
				)}
			</section>
		)
	}

	{
		selectedSlug ? (
			<details class="default-links-disclosure">
				<summary class="default-links-summary">
					<span class="default-links-summary-label">
						About {aboutName}
					</span>
				</summary>
				<div class="default-links-disclosure-panel">
					<section class="default-links-section">
						<h1>Link Lander</h1>
						<p>
							Default links are always visible. Slug-specific links
							and featured content append below.
						</p>
					</section>
					<section>
						<h2>Default Links</h2>
						<ul>
							{defaultLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</section>
				</div>
			</details>
		) : (
			<>
				<section class="default-links-section">
					<h1>Link Lander</h1>
					<p>
						Default links are always visible. Slug-specific links and
						featured content append below.
					</p>
				</section>
				<section>
					<h2>Default Links</h2>
					<ul>
						{defaultLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</section>
			</>
		)
	}
</main>

<style>
	main {
		box-sizing: border-box;
		max-width: 40vw;
		margin: 2rem;
		padding: 2rem 1rem 4rem;
		font-family: Inter, system-ui, sans-serif;
		line-height: 1.5;
		background-color: #fff;
		border-radius: 1rem;
		overflow-y: scroll;
		height: 90vh;
	}

	section {
		margin-bottom: 2rem;
	}

	.paid-links-list{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		list-style: none;
		padding: 0;
		gap: 0.5rem;
	}

	.free-links-list{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		list-style: none;
		padding: 0;
		gap: 0.5rem;
	}

	h1,
	h2,
	h3 {
		margin: 0 0 0.5rem;
	}

	ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	audio {
		width: 100%;
		max-width: 26rem;
	}

	.default-links-disclosure {
		margin-bottom: 2rem;
	}

	.default-links-summary {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0;
		cursor: pointer;
		user-select: none;
	}

	.default-links-summary::-webkit-details-marker {
		display: none;
	}

	.default-links-summary::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		border-right: 2px solid #6b7280;
		border-bottom: 2px solid #6b7280;
		transform: rotate(-45deg);
		vertical-align: middle;
		transition: transform 0.15s ease;
	}

	.default-links-disclosure[open] .default-links-summary::before {
		transform: rotate(45deg);
		margin-top: 0.15rem;
	}

	.default-links-summary-label {
		flex: 1 1 auto;
		min-width: 0;
	}
	.cover-image {
		border-radius: 1rem;
		border: 1px solid #95b9ff;
		width: 80%;
	}

	.default-links-disclosure-panel {
		padding: 0;
	}

	.default-links-disclosure-panel section:last-child {
		margin-bottom: 0;
	}


	@media (max-width: 440px) and (orientation: portrait) {
		main {
			max-width: none;
			width: auto;
			margin: 1rem;
			padding: 1.25rem 1rem 3rem;
			border-radius: 0.75rem;
			overflow-y: scroll;
			height: auto;
		}
		.cover-image {
			width: 100%;
		}
	}
</style>
