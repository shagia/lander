---
import type { SlugEntry } from "../lib/landing";
import {siSoundcloud, siApplemusic, siSpotify, siBandcamp, siTidal} from "simple-icons";
import DefaultLinksContent from "./DefaultLinksContent.astro";

const slugLinkSvgById: Record<string, string> = {
	soundcloud: siSoundcloud.svg,
	"apple-music": siApplemusic.svg,
	spotify: siSpotify.svg,
	bandcamp: siBandcamp.svg,
	tidal: siTidal.svg,
};
const slugLinkSvgFallback = siBandcamp.svg;

function slugLinkSvgMarkup(id: string) {
	return slugLinkSvgById[id] ?? slugLinkSvgFallback;
}

/** Appends host in parentheses for screen readers (e.g. ` (example.com)`). */
function linkDestinationHint(href: string) {
	try {
		const host = new URL(href).host;
		return host ? ` (${host})` : "";
	} catch {
		return "";
	}
}

interface Props {
	selectedSlug?: SlugEntry;
}

const { selectedSlug } = Astro.props;

const aboutName =
	selectedSlug?.data.music?.artist ?? selectedSlug?.data.title ?? "";

const slugSmallLinks = selectedSlug?.data.links?.small ?? [];
const slugLargeLinks = selectedSlug?.data.links?.large ?? [];
---

<main class="main-container">
	<div class="main-container-scroll">
	{
		selectedSlug && (
			<section>
				<div class="media-container-wrapper">
					{selectedSlug.data.cover && (
						<div class="cover-container">
							<article>
								{/* I have zero issues with assuming that a string, no matter what, is being passed to the cover key - there's a smarter way for this but oh well */}
								<img
									src={
										selectedSlug.data
											.cover as unknown as string
									}
									alt={selectedSlug.data.title}
									class="cover-image"
								/>
							</article>
						</div>
					)}
					{selectedSlug.data.music && (
						<div class="media-container">
							<article>
								<audio
									controls
									src={selectedSlug.data.music.audioUrl}
								/>
							</article>
						</div>
					)}
					{(slugSmallLinks.length > 0 || slugLargeLinks.length > 0) && (
					<>
						{slugLargeLinks.length > 0 && (
							<ul class="links-large-list">
								{slugLargeLinks.map((link) => (
									<li>
										<a href={link.href} class="link-large">
											<span
												class="link-large-icon"
												aria-hidden="true"
												set:html={slugLinkSvgMarkup(link.id)}
											/>
											<span class="link-large-label">
												{link.label}
											</span>
											<span class="visually-hidden">
												{linkDestinationHint(link.href)}
											</span>
										</a>
									</li>
								))}
							</ul>
						)}
						{slugSmallLinks.length > 0 && (
							<ul class="links-small-list">
								{slugSmallLinks.map((link) => (
									<li>
										<a href={link.href} class="link-small">
											<span class="visually-hidden">
												{link.label}
												{linkDestinationHint(link.href)}
											</span>
											<span
												class="link-small-icon"
												aria-hidden="true"
												set:html={slugLinkSvgMarkup(
													link.id,
												)}
											/>
										</a>
									</li>
								))}
							</ul>
						)}
					</>
				)}
				</div>

				
				<br />

				
				{selectedSlug.data.featured && (
					<h2>{selectedSlug.data.title}</h2>

					<details class="default-links-disclosure">
					<summary class="default-links-summary">
						<span class="default-links-summary-label">
							Information
						</span>
					</summary>
					<div class="default-links-disclosure-panel">
						<br />
						<section class="default-links-section">
							<h3>{selectedSlug.data.featured.headline}</h3>
							{selectedSlug.data.featured.summary.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</section>
					</div>
				</details>
				)}
			</section>
		)
	}

	{
		selectedSlug ? (
			<details class="default-links-disclosure">
				<summary class="default-links-summary">
					<span class="default-links-summary-label">
						About {aboutName}
					</span>
				</summary>
				<div class="default-links-disclosure-panel">
					<DefaultLinksContent
						linkDestinationHint={linkDestinationHint}
					/>
				</div>
			</details>
		) : (
			<DefaultLinksContent linkDestinationHint={linkDestinationHint} />
		)
	}
	</div>
</main>

<style>
	.main-container {
		--main-container-bg: rgba(255, 255, 255, 0.8);
		--main-container-fade: 3.25rem;

		position: relative;
		box-sizing: border-box;
		max-width: 40vw;
		margin: 0;
		padding: 0;
		font-family: Inter, system-ui, sans-serif;
		font-weight: 500;
		line-height: 1.5;
		background-color: var(--main-container-bg);
		border-radius: 1rem;
		border: 6px solid rgba(255, 255, 255, 0.2);
		overflow: hidden;
		height: 100%;
		backdrop-filter: blur(10px);
		isolation: isolate;
		transform: rotate(-0.02deg);
	}

	.main-container::before,
	.main-container::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		padding-top: 10px;
		height: var(--main-container-fade);
		pointer-events: none;
		z-index: 2;
	}

	.main-container::before {
		top: 0;
		background: linear-gradient(
			to bottom,
			var(--main-container-bg),
			transparent
		);
	}

	.main-container::after {
		bottom: 0;
		background: linear-gradient(
			to top,
			var(--main-container-bg),
			transparent
		);
	}

	.main-container-scroll {
		box-sizing: border-box;
		height: 100%;
		overflow-y: auto;
		padding: 3rem;
		position: relative;
		z-index: 0;
	}
	.media-container-wrapper {
		width: 100%;
	}

	section {
		margin-bottom: 2rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.links-large-list {
		display: flex;
		flex-direction: column;
		list-style: none;
		padding: 0;
		margin: 0 0 0.75rem;
		gap: 0.5rem;
		width: 100%;
	}

	.links-large-list .link-large {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		box-sizing: border-box;
		padding: 0.65rem 1rem;
		text-decoration: none;
		color: #111827;
		background: #f3f4f6;
		border-radius: 0.5rem;
		border: 1px solid #e5e7eb;
		font-weight: 600;
	}

	.links-large-list .link-large:hover {
		background: #e5e7eb;
	}

	.links-small-list {
		display: flex;
		flex-direction: row;
		list-style: none;
		padding: 0;
		margin: 0;
		gap: 0.4rem;
		align-items: center;
	}

	.links-small-list li {
		width: 100%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.links-small-list .link-small {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem 0.5rem;
		font-size: 0.8125rem;
		text-decoration: none;
		color: #374151;
		background: #fff;
		border: 1px solid #d1d5db;
		border-radius: 9999px;
		line-height: 1.2;
		width:100%;
		height: 30px;
	}

	.link-small-icon :global(svg),
	.link-large-icon :global(svg) {
		display: block;
		fill: currentColor;
	}

	.link-small-icon :global(svg) {
		width: 1.125rem;
		height: 1.125rem;
	}

	.link-large-icon :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}

	.links-small-list .link-small:hover {
		border-color: #9ca3af;
		background: #f9fafb;
	}

	.main-container a:focus-visible {
		outline: 2px solid #2563eb;
		outline-offset: 2px;
	}

	h1,
	h2,
	h3 {
		margin: 0 0 0.5rem;
	}

	ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	audio {
		width: 100%;
	}

	.default-links-disclosure {
		margin-bottom: 2rem;
	}

	.default-links-summary {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0;
		cursor: pointer;
		user-select: none;
	}

	.default-links-summary::-webkit-details-marker {
		display: none;
	}

	.default-links-summary::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		border-right: 2px solid #6b7280;
		border-bottom: 2px solid #6b7280;
		transform: rotate(-45deg);
		vertical-align: middle;
		transition: transform 0.15s ease;
	}

	.default-links-disclosure[open] .default-links-summary::before {
		transform: rotate(45deg);
		margin-top: 0.15rem;
	}

	.default-links-summary-label {
		flex: 1 1 auto;
		min-width: 0;
	}
	.cover-image {
		border-radius: 1rem;
		border: 1px solid #95b9ff;
		width: 100%;
	}

	.default-links-disclosure-panel {
		padding: 0;
	}

	.default-links-disclosure-panel section:last-child {
		margin-bottom: 0;
	}


	@media (max-width: 630px) and (orientation: portrait) {
		.main-container {
			max-width: none;
			width: auto;
			margin: 0;
			border-radius: 0.75rem;
			height: auto;
		}

		.main-container::before {
			border-radius: 0.75rem 0.75rem 0 0;
		}

		.main-container::after {
			border-radius: 0 0 0.75rem 0.75rem;
		}

		.main-container-scroll {
			height: auto;
			overflow-y: visible;
			padding: 1.25rem 1rem 3rem;
		}

		.cover-image {
			width: 100%;
		}

		.media-container-wrapper {
			width: 100%;
		}
	}
</style>
