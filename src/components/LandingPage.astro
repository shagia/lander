---
import { coverSrc, getMods, type ReleaseEntry } from "../lib/landing";
import {
	siSoundcloud,
	siApplemusic,
	siSpotify,
	siBandcamp,
	siTidal,
} from "simple-icons";
import "../styles/components/landing-page.scss";
import AboutText from "./mods/About/AboutText.astro";
import Banner from "./mods/Banner/Banner.astro";
import PerformancesText from "./mods/Performances/PerformancesText.astro";
import ProjectsText from "./mods/Projects/ProjectsText.astro";
import Releases from "./mods/Releases/Releases.astro";
import AudioPlayer from "./mods/AudioPlayer/AudioPlayer.astro";
import SocialLinksContent from "./mods/SocialLinksContent/SocialLinksContent.astro";

const mods = await getMods();

const releaseLinkSvgById: Record<string, string> = {
	soundcloud: siSoundcloud.svg,
	"apple-music": siApplemusic.svg,
	spotify: siSpotify.svg,
	bandcamp: siBandcamp.svg,
	tidal: siTidal.svg,
};
const releaseLinkSvgFallback = siBandcamp.svg;

function releaseLinkSvgMarkup(id: string) {
	const svg = releaseLinkSvgById[id] ?? releaseLinkSvgFallback;
	// Simple Icons fill the 24×24 canvas (some paths even spill past it).
	// Expand the viewBox so SVG overflow:hidden does not clip the marks.
	return svg.replace('viewBox="0 0 24 24"', 'viewBox="-2 -2 28 28"');
}

/** Appends host in parentheses for screen readers (e.g. ` (example.com)`). */
function linkDestinationHint(href: string) {
	try {
		const host = new URL(href).host;
		return host ? ` (${host})` : "";
	} catch {
		return "";
	}
}

interface Props {
	selectedRelease?: ReleaseEntry;
}

const { selectedRelease } = Astro.props;

const releaseSmallLinks = selectedRelease?.data.links?.small ?? [];
const releaseLargeLinks = selectedRelease?.data.links?.large ?? [];
const featuredHeadline = selectedRelease?.data.featured?.headline;
const featuredSummary = selectedRelease?.data.featured?.summary ?? [];
const showFeatured = Boolean(featuredHeadline || featuredSummary.length > 0);
---

<div class="landing-shell" transition:name="landing-shell">
	<main
		id="main-content"
		tabindex="-1"
		class:list={[
			"main-container",
			{ "main-container--default": !selectedRelease },
		]}
	>
		<div class="main-container-fades" aria-hidden="true"></div>
		<div class="main-container-scroll">
			<div class="main-container-scroll-inner">
				{!selectedRelease && mods.banner && <Banner />}
				{
					selectedRelease && (
						<section class="release-section">
							<h2 class="release-title">
								{selectedRelease.data.title}
							</h2>
							<div class="media-container-wrapper">
								<div class="cover-container">
									<img
										src={coverSrc(selectedRelease.data.cover)}
										alt={selectedRelease.data.title}
										class="cover-image"
									/>
								</div>
								{mods.audioPlayer && (
									<AudioPlayer selectedRelease={selectedRelease} />
								)}
								{(releaseSmallLinks.length > 0 ||
									releaseLargeLinks.length > 0) && (
									<>
										{releaseLargeLinks.length > 0 && (
											<ul class="links-large-list">
												{releaseLargeLinks.map((link) => (
													<li>
														<a
															href={link.href}
															class="link-large"
														>
															<span
																class="link-large-icon"
																aria-hidden="true"
																set:html={releaseLinkSvgMarkup(
																	link.id,
																)}
															/>
															<span class="link-large-label">
																{link.label}
															</span>
															<span class="visually-hidden">
																{linkDestinationHint(
																	link.href,
																)}
															</span>
														</a>
													</li>
												))}
											</ul>
										)}
										{releaseSmallLinks.length > 0 && (
											<ul class="links-small-list">
												{releaseSmallLinks.map((link) => (
													<li>
														<a
															href={link.href}
															class="link-small"
														>
															<span class="visually-hidden">
																{link.label}
																{linkDestinationHint(
																	link.href,
																)}
															</span>
															<span
																class="link-small-icon"
																aria-hidden="true"
																set:html={releaseLinkSvgMarkup(
																	link.id,
																)}
															/>
														</a>
													</li>
												))}
											</ul>
										)}
									</>
								)}
							</div>

							{showFeatured && (
								<section class="release-featured">
									{featuredHeadline && (
										<h3>{featuredHeadline}</h3>
									)}
									{featuredSummary.map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</section>
							)}
						</section>
					)
				}

				{
					selectedRelease ? (
						<>
							{mods.aboutText && <AboutText />}
							{mods.releases && (
								<Releases variant="image" onReleasePage paged />
							)}
						</>
					) : (
						<div class="landing-default-columns">
							<div class="landing-default-column landing-default-column--music">
								{mods.releases && <Releases variant="text" paged />}
								{mods.performancesText && (
									<PerformancesText paged />
								)}
							</div>
							<div class="landing-default-column landing-default-column--links">
								{mods.socialLinksContent && (
									<SocialLinksContent />
								)}
								{mods.projectsText && (
									<ProjectsText />
								)}
							</div>
							<div class="landing-default-column landing-default-column--about">
								{mods.aboutText && <AboutText />}
							</div>
						</div>
					)
				}
			</div>
		</div>
	</main>
</div>

<script>
	let bgScrollAbort: AbortController | null = null;

	function initLandingBgScroll() {
		bgScrollAbort?.abort();
		bgScrollAbort = new AbortController();
		const { signal } = bgScrollAbort;

		document.body.classList.remove("bg-scroll-js");
		document.body.style.removeProperty("--bg-scroll");

		const firefoxNeedsBgScrollPolyfill = CSS.supports(
			"-moz-appearance: none",
		);
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		const scroller = document.querySelector(".landing-shell");

		if (
			!firefoxNeedsBgScrollPolyfill ||
			prefersReducedMotion ||
			!(scroller instanceof HTMLElement)
		) {
			return;
		}

		document.body.classList.add("bg-scroll-js");

		const bgImage = new Image();
		let ticking = false;
		let maxTravel = 0;

		const backgroundUrl = () => {
			const value = getComputedStyle(document.body)
				.getPropertyValue("--page-bg")
				.trim();
			return value.match(/url\((['"]?)(.*?)\1\)/)?.[2] ?? "";
		};

		const coverOverflowY = () => {
			const { naturalWidth, naturalHeight } = bgImage;
			if (!naturalWidth || !naturalHeight) return 0;

			const scale = Math.max(
				window.innerWidth / naturalWidth,
				window.innerHeight / naturalHeight,
			);
			return Math.max(0, naturalHeight * scale - window.innerHeight);
		};

		const syncBackground = () => {
			const maxScroll = scroller.scrollHeight - scroller.clientHeight;
			const progress = maxScroll > 0 ? scroller.scrollTop / maxScroll : 0;
			document.body.style.setProperty(
				"--bg-scroll",
				`${progress * maxTravel}px`,
			);
			ticking = false;
		};

		const requestSync = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(syncBackground);
		};

		const recalc = () => {
			maxTravel = coverOverflowY() / 2;
			syncBackground();
		};

		const url = backgroundUrl();
		if (url) {
			bgImage.addEventListener("load", recalc, { signal });
			bgImage.src = url;
			if (bgImage.complete) recalc();
		}

		scroller.addEventListener("scroll", requestSync, {
			passive: true,
			signal,
		});
		window.addEventListener("resize", recalc, { signal });

		const resizeObserver = new ResizeObserver(recalc);
		resizeObserver.observe(scroller);
		for (const child of scroller.children) {
			resizeObserver.observe(child);
		}
		signal.addEventListener("abort", () => resizeObserver.disconnect());
	}

	document.addEventListener("astro:page-load", initLandingBgScroll);
</script>
