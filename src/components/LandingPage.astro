---
import type { SlugEntry } from "../lib/landing";
import { defaultLinks } from "../lib/landing";

interface Props {
	selectedSlug?: SlugEntry;
}

const { selectedSlug } = Astro.props;
---

<main>
	{
		selectedSlug && (
			<section>
				<div class="media-container-wrapper">
					{selectedSlug.data.cover && (
						<div class="cover-container">
							<article>
								{/* I have zero issues with assuming that a string, no matter what, is being passed to the cover key - there's a smarter way for this but oh well */}
								<img
									src={
										selectedSlug.data
											.cover as unknown as string
									}
									alt={selectedSlug.data.title}
									width={300}
									height={300}
								/>
							</article>
						</div>
					)}
					{selectedSlug.data.music && (
						<div class="media-container">
							<article>
								<audio
									controls
									src={selectedSlug.data.music.audioUrl}
								/>
							</article>
						</div>
					)}
				</div>

				<h2>{selectedSlug.data.title}</h2>
				<p>{selectedSlug.data.description}</p>

				{(selectedSlug.data.links.paid.length > 0 ||
					selectedSlug.data.links.free.length > 0) && (
					<>
						<h3>Slug-Specific Links</h3>
						{selectedSlug.data.links.paid.length > 0 && (
							<>
								<h4>Requires Payment</h4>
								<ul>
									{selectedSlug.data.links.paid.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							</>
						)}
						{selectedSlug.data.links.free.length > 0 && (
							<>
								<h4>Free Downloads</h4>
								<ul>
									{selectedSlug.data.links.free.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							</>
						)}
					</>
				)}
				<br />

				{selectedSlug.data.featured && (
					<article>
						<h3>{selectedSlug.data.featured.headline}</h3>
						<p>{selectedSlug.data.featured.summary}</p>
					</article>
				)}
			</section>
		)
	}

	<section>
		<h1>Link Lander</h1>
		<p>
			Default links are always visible. Slug-specific links and featured
			content append below.
		</p>
	</section>

	<section>
		<h2>Default Links</h2>
		<ul>
			{
				defaultLinks.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</section>
</main>

<style>
	main {
		max-width: 50rem;
		margin: 2rem;
		padding: 2rem 1rem 4rem;
		font-family: Inter, system-ui, sans-serif;
		line-height: 1.5;
		background-color: #fff;
		border-radius: 1rem;
	}

	section {
		margin-bottom: 2rem;
	}

	h1,
	h2,
	h3 {
		margin: 0 0 0.5rem;
	}

	ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	audio {
		width: 100%;
		max-width: 26rem;
	}
</style>
