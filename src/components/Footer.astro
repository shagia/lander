---
import "../styles/global/footer.scss";

interface Props {
	legalName: string;
	email: string;
}

const { legalName, email } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" transition:persist="site-footer">
	<p>© {year} {legalName} All rights reserved | <a href={`mailto:${email}`}>{email}</a></p>
</footer>
