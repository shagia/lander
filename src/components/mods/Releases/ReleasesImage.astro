---
import { coverSrc, getReleaseSlugs } from "../../../lib/landing";
import "../../../styles/components/mods/Releases/releases-image.scss";

interface Props {
	onSlugPage?: boolean;
	initialVisible?: number;
}

const { onSlugPage = false, initialVisible: initialVisibleProp } = Astro.props;
const releases = await getReleaseSlugs();
const heading = onSlugPage ? "More Music" : "Music";
const initialVisible = initialVisibleProp ?? 2;
const canCollapse = releases.length > initialVisible;

function formatPublishedAt(date: Date) {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

{
	releases.length > 0 && (
		<section class="releases" aria-labelledby="releases-heading">
			{canCollapse ? (
				<details class="releases-disclosure">
					<summary class="releases-summary">
						<span
							class="releases-summary-label"
							id="releases-heading"
						>
							{heading}
						</span>
					</summary>
				</details>
			) : (
				<h2 id="releases-heading">{heading}</h2>
			)}
			<ul class="releases-list">
				{releases.map((release, index) => {
					const src = coverSrc(release.data.cover);
					const href = `/${release.id}`;
					return (
						<li
							class:list={[
								"releases-item",
								{ "is-extra": index >= initialVisible },
							]}
						>
							<a class="releases-card" href={href}>
								<img
									class="releases-thumb"
									src={src}
									alt=""
									loading="lazy"
									decoding="async"
								/>
								<span class="releases-title">
									{release.data.title}
								</span>
								<time
									class="releases-date"
									datetime={release.data.publishedAt.toISOString()}
								>
									{formatPublishedAt(release.data.publishedAt)}
								</time>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}
