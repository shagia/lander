---
import { coverSrc, getSiteConfig } from "../../../lib/landing";
import "../../../styles/components/mods/Banner/banner.scss";

interface Props {
	/** Banner image URL. Defaults to `Site.yaml` banner.image, then placeholder. */
	src?: string;
	/**
	 * CSS `object-position` for the crop (e.g. `"top"`, `"center 20%"`, `"50% 10%"`).
	 * Defaults to `Site.yaml` banner.position, then the top of the image.
	 */
	position?: string;
	/**
	 * Zoom scale for the image (`1` = fill the banner, `1.25` = 25% zoomed in).
	 * Defaults to `Site.yaml` banner.imageSize, then `1`.
	 */
	imageSize?: number;
	/** Optional photo credit shown under the banner. Defaults to `Site.yaml` banner.credit. */
	credit?: string;
}

const site = await getSiteConfig();
const banner = site?.data.banner;

const {
	src = coverSrc(banner?.image),
	position = banner?.position ?? "top",
	imageSize = banner?.imageSize ?? 1,
	credit = banner?.credit,
} = Astro.props;
const imageSrc = coverSrc(src);
const scale = Number.isFinite(imageSize) && imageSize > 0 ? imageSize : 1;
---

<div class="landing-banner-block">
	<div class="landing-banner">
		<img
			class="landing-banner-image"
			src={imageSrc}
			alt=""
			decoding="async"
			style={`--banner-image-position: ${position}; --banner-image-size: ${scale}`}
		/>
	</div>
	{
		credit && (
			<p class="landing-banner-credit">{credit}</p>
		)
	}
</div>
