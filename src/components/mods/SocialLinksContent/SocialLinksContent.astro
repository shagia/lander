---
import { getSiteConfig } from "../../../lib/landing";

const socials = {
	soundcloud: "https://soundcloud.com/",
	instagram: "https://www.instagram.com/",
	bluesky: "https://bsky.app/profile/",
	twitter: "https://x.com/",
	email: "mailto:",
} as const;

type SocialId = keyof typeof socials;

const site = await getSiteConfig();
const handles = site?.data.socials;

const links = (Object.keys(socials) as SocialId[]).flatMap((id) => {
	const raw = handles?.[id]?.trim() ?? "";
	const value = id === "email" ? raw : raw.replace(/^@/, "");
	if (!value) return [];
	return [{ id, label: id, href: `${socials[id]}${value}` }];
});
---

{
	links.length > 0 && (
		<section>
			<h2>Socials</h2>
			<ul class="social-links-list">
				{links.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		</section>
	)
}
