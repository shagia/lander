---
import { getSiteConfig } from "../../../lib/landing";
import { socialHref } from "../../../lib/socials";

const site = await getSiteConfig();
const handles = site?.data.socials;

const links = Object.entries(handles ?? {}).flatMap(([id, raw]) => {
	const value = raw?.trim() ?? "";
	if (!value) return [];
	const href = socialHref(id, value);
	return [{ id, label: id, href }];
});
---

{
	links.length > 0 && (
		<section>
			<h2>Socials</h2>
			<ul class="social-links-list">
				{links.map((link) => (
					<li>
						{link.href ? (
							<a href={link.href}>{link.label}</a>
						) : (
							<span>{link.label}</span>
						)}
					</li>
				))}
			</ul>
		</section>
	)
}
