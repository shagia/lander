---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<Header />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #cfcfcf;
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-weight: 400;
		color: #141b2c;
	}

	:global(a) {
		color: inherit;
	}

	body > :global(.landing-shell) {
		flex: 1;
		min-height: 0;
	}

	body {
		--bg-scroll: 0px;
		--page-bg: url("https://f4.bcbits.com/img/a3793080960_10.jpg");
		box-sizing: border-box;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 2rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		font-size: 1.2rem;
		line-height: 1.5;
		background-image:
			radial-gradient(
				ellipse 80% 100% at 22% 50%,
				rgb(207, 207, 207) 0%,
				rgb(207, 207, 207) 50%,
				rgba(207, 207, 207, 0.88) 72%,
				rgba(207, 207, 207, 0.78) 100%
			),
			var(--page-bg);
		background-size: 100% 100%, cover;
		background-position:
			right center,
			right calc(50% - var(--bg-scroll));
		background-attachment: fixed;
		background-repeat: no-repeat;

	}

	@media (max-width: 630px) and (orientation: portrait) {
		body {
			background-image: none;
			padding: 1rem;
		}
	}

</style>
