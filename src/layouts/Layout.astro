---
import logo from "../assets/logo.svg";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<img src={logo.src} width="361" height="264" alt="Logo" class="site-logo" />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #cfcfcf;
	}

	.site-logo {
		display: block;
		width: auto;
		height: 3.5rem;
		margin-bottom: 1rem;
		margin-left: calc(6px + 3rem);
		flex-shrink: 0;
		align-self: flex-start;
	}

	body > :global(.main-container) {
		flex: 1;
		min-height: 0;
	}

	body {
		--bg-scroll: 0px;
		--page-bg: url("https://f4.bcbits.com/img/a3793080960_10.jpg");
		box-sizing: border-box;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 2rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		background-image:
			radial-gradient(
				ellipse 80% 100% at 22% 50%,
				rgb(207, 207, 207) 0%,
				rgb(207, 207, 207) 50%,
				rgba(207, 207, 207, 0.88) 72%,
				rgba(207, 207, 207, 0.78) 100%
			),
			var(--page-bg);
		background-size: 100% 100%, cover;
		background-position:
			right center,
			right calc(50% - var(--bg-scroll));
		background-attachment: fixed;
		background-repeat: no-repeat;
	}

	@media (max-width: 630px) and (orientation: portrait) {
		html,
		body {
			height: auto;
		}

		body {
			background-image: none;
			padding: 1rem;
			overflow: visible;
		}

		.site-logo {
			margin-left: calc(6px + 1rem);
		}
	}

</style>
