---
import "../styles/global/colors.scss";
import "../styles/global/layout.scss";
import "../styles/global/scrollbar.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LinkLens from "../components/mods/LinkLens/LinkLens.astro";
import { pageBackgroundImage } from "../lib/landing";

interface Props {
	cover?: string;
	/** Override theme: `"dark"` | `"light"`. Omit to follow the system/browser color scheme. */
	theme?: "dark" | "light";
}

const { cover, theme } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body style={`--page-bg: ${pageBackgroundImage(cover)}`}>
		<Header />
		<slot />
		<Footer />
		<LinkLens />
	</body>
</html>

